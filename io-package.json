  "native": {
    "host": "",
    "port": 8443,
    "password": "",
    "rawStates": false
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": {
          "en": "Information",
          "de": "Informationen"
        }
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": {
          "en": "Connected to the GARDENA smart Gateway",
          "de": "Mit dem GARDENA smart Gateway verbunden"
        },
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.gateway",
      "type": "state",
      "common": {
        "name": {
          "en": "Gateway name",
          "de": "Name des Gateways"
        },
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.devices",
      "type": "state",
      "common": {
        "name": {
          "en": "Number of devices",
          "de": "Anzahl Geräte"
        },
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.certificateFingerprint",
      "type": "state",
      "common": {
        "name": {
          "en": "Trusted gateway certificate (SHA-256)",
          "de": "Vertrautes Gateway-Zertifikat (SHA-256)"
        },
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.certificate",
      "type": "state",
      "common": {
        "name": {
          "en": "Trusted gateway certificate (PEM)",
          "de": "Vertrautes Gateway-Zertifikat (PEM)"
        },
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.trustNewCertificate",
      "type": "state",
      "common": {
        "name": {
          "en": "Trust new gateway certificate (after gateway reset)",
          "de": "Neues Gateway-Zertifikat vertrauen (nach Gateway-Reset)"
        },
        "type": "boolean",
        "role": "button",
        "read": false,
        "write": true
      },
      "native": {}
    }
  ],
  "encryptedNative": [
    "password"
  ],
  "protectedNative": [
    "password"
  ]
}
