    ],
    "licenseInformation": {
      "type": "free",
      "license": "MIT"
    },
    "platform": "Javascript/Node.js",
    "icon": "gardena-smart.png",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/Schimi1983/ioBroker.gardena-smart/main/admin/gardena-smart.png",
    "readme": "https://github.com/Schimi1983/ioBroker.gardena-smart/blob/main/README.md",
    "loglevel": "info",
    "tier": 3,
    "mode": "daemon",
    "type": "garden",
    "compact": true,
    "connectionType": "local",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=6.0.11"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=7.6.20"
      }
    ]
  },
  "native": {
    "host": "",
    "port": 8443,
    "password": "",
    "appKey": "",
    "appSecret": "",
    "cloudLimit": 1000,
    "rawStates": false
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": {
          "en": "Information",
          "de": "Informationen"
        }
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": {
          "en": "Connected to the GARDENA smart Gateway",
          "de": "Mit dem GARDENA smart Gateway verbunden"
        },
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.gateway",
      "type": "state",
      "common": {
        "name": {
          "en": "Gateway name",
          "de": "Name des Gateways"
        },
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.devices",
      "type": "state",
      "common": {
        "name": {
          "en": "Number of devices",
          "de": "Anzahl Geräte"
        },
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.certificateFingerprint",
      "type": "state",
      "common": {
        "name": {
          "en": "Trusted gateway certificate (SHA-256)",
          "de": "Vertrautes Gateway-Zertifikat (SHA-256)"
        },
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.certificate",
      "type": "state",
      "common": {
        "name": {
          "en": "Trusted gateway certificate (PEM)",
          "de": "Vertrautes Gateway-Zertifikat (PEM)"
        },
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.trustNewCertificate",
      "type": "state",
      "common": {
        "name": {
          "en": "Trust new gateway certificate (after gateway reset)",
          "de": "Neues Gateway-Zertifikat vertrauen (nach Gateway-Reset)"
        },
        "type": "boolean",
        "role": "button",
        "read": false,
        "write": true
      },
      "native": {}
    },
    {
      "_id": "cloud",
      "type": "channel",
      "common": {
        "name": {
          "en": "GARDENA cloud (optional)",
          "de": "GARDENA-Cloud (optional)"
        }
      },
      "native": {}
    },
    {
      "_id": "cloud.connection",
      "type": "state",
      "common": {
        "name": {
          "en": "Last cloud request successful",
          "de": "Letzte Cloud-Abfrage erfolgreich"
        },
        "read": true,
        "write": false,
        "type": "boolean",
        "role": "indicator.reachable",
        "def": false
      },
      "native": {}
    },
    {
      "_id": "cloud.lastUpdate",
      "type": "state",
      "common": {
        "name": {
          "en": "Last successful cloud request",
          "de": "Letzte erfolgreiche Cloud-Abfrage"
        },
        "read": true,
        "write": false,
        "type": "number",
        "role": "value.time"
      },
      "native": {}
    },
    {
      "_id": "cloud.refresh",
      "type": "state",
      "common": {
        "name": {
          "en": "Read names from the cloud now (uses 2 requests)",
          "de": "Namen jetzt aus der Cloud lesen (verbraucht 2 Abfragen)"
        },
        "read": false,
        "write": true,
        "type": "boolean",
        "role": "button"
      },
      "native": {}
    },
    {
      "_id": "cloud.blocked",
      "type": "state",
      "common": {
        "name": {
          "en": "Cloud paused (too many requests)",
          "de": "Cloud pausiert (zu viele Abfragen)"
        },
        "read": true,
        "write": false,
        "type": "boolean",
        "role": "indicator.alarm",
        "def": false
      },
      "native": {}
    },
    {
      "_id": "cloud.blockedUntil",
      "type": "state",
      "common": {
        "name": {
          "en": "Cloud paused until",
          "de": "Cloud pausiert bis"
        },
        "read": true,
        "write": false,
        "type": "number",
        "role": "value.time"
      },
      "native": {}
    },
    {
      "_id": "cloud.quota",
      "type": "channel",
      "common": {
        "name": {
          "en": "Cloud requests (last 7 days)",
          "de": "Cloud-Abfragen (letzte 7 Tage)"
        }
      },
      "native": {}
    },
    {
      "_id": "cloud.quota.used",
      "type": "state",
      "common": {
        "name": {
          "en": "Requests used in the last 7 days",
          "de": "Verbrauchte Abfragen (7 Tage)"
        },
        "read": true,
        "write": false,
        "type": "number",
        "role": "value",
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "cloud.quota.limit",
      "type": "state",
      "common": {
        "name": {
          "en": "Weekly limit",
          "de": "Wochenlimit"
        },
        "read": true,
        "write": false,
        "type": "number",
        "role": "value",
        "def": 1000
      },
      "native": {}
    },
    {
      "_id": "cloud.quota.remaining",
      "type": "state",
      "common": {
        "name": {
          "en": "Requests left",
          "de": "Verbleibende Abfragen"
        },
        "read": true,
        "write": false,
        "type": "number",
        "role": "value",
        "def": 1000
      },
      "native": {}
    },
    {
      "_id": "cloud.quota.percent",
      "type": "state",
      "common": {
        "name": {
          "en": "Used share of the weekly limit",
          "de": "Anteil am Wochenlimit"
        },
        "read": true,
        "write": false,
        "type": "number",
        "role": "value",
        "unit": "%",
        "min": 0,
        "max": 100,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "cloud.quota.warning",
      "type": "state",
      "common": {
        "name": {
          "en": "80 % of the weekly limit used",
          "de": "80 % des Wochenlimits verbraucht"
        },
        "read": true,
        "write": false,
        "type": "boolean",
        "role": "indicator.alarm",
        "def": false
      },
      "native": {}
    },
    {
      "_id": "cloud.quota.reset",
      "type": "state",
      "common": {
        "name": {
          "en": "Reset counter (e.g. after creating a new App Key)",
          "de": "Zähler zurücksetzen (z. B. nach neuem App-Key)"
        },
        "read": false,
        "write": true,
        "type": "boolean",
        "role": "button"
      },
      "native": {}
    },
    {
      "_id": "cloud.quota.log",
      "type": "state",
      "common": {
        "name": {
          "en": "Times of the counted requests (internal)",
          "de": "Zeitpunkte der gezählten Abfragen (intern)"
        },
        "read": true,
        "write": false,
        "type": "string",
        "role": "json",
        "def": "[]"
      },
      "native": {}
    }
  ],
  "encryptedNative": [
    "password",
    "appSecret"
  ],
  "protectedNative": [
    "password",
    "appSecret"
  ]
}
